# PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CURRENCY=USD
# Webhook id from Developer Dashboard > Webhooks (event PAYMENT.CAPTURE.COMPLETED).
# Leave empty locally and set SHELF_ALLOW_UNVERIFIED_WEBHOOKS=1 only for local testing.
PAYPAL_WEBHOOK_ID=
SHELF_ALLOW_UNVERIFIED_WEBHOOKS=0

# Public base URL (used for PayPal return/cancel urls). Example: https://shelf-paypal.onrender.com
PUBLIC_URL=

# Seller actions (approve, ship, upload) require this header when set: X-Shelf-Admin
SHELF_ADMIN_TOKEN=

# Gemini: one key, or a comma list, or GEMINI_API_KEY_1..N
GOOGLE_API_KEY=
GEMINI_KEYS=
SHELF_GEMINI_MODEL=gemini-3.5-flash-lite

# Storage: local JSON (default) or Firestore
SHELF_FIRESTORE=0
SHELF_GCS_BUCKET=
